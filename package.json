{
  "name": "trogon-eventstore-client-nodejs",
  "private": true,
  "packageManager": "yarn@4.6.0",
  "scripts": {
    "build": "nx run-many --target=build",
    "build:ts": "nx run-many --target=build:ts",
    "build:watch": "nx run-many --target=build:watch --parallel",
    "lint": "prettier --check \"packages/*/src/**/**/!(*.d).{ts,json}\" && eslint packages/*/src --ext .ts --no-error-on-unmatched-pattern",
    "prettier:fix": "prettier --write \"packages/*/src/**/**/!(*.d).{ts,json}\"",
    "clean": "nx run-many --target=clean",
    "prepublishOnly": "yarn clean && yarn build && yarn test",
    "test": "nx run test:test"
  },
  "author": "Straw Hat, LLC",
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/TrogonStack/TrogonEventStore-Client-NodeJS/issues"
  },
  "workspaces": [
    "packages/*"
  ],
  "homepage": "https://github.com/TrogonStack/TrogonEventStore-Client-NodeJS",
  "devDependencies": {
    "@tsconfig/node18": "^18.2.4",
    "@types/node": "18.19.76",
    "@types/semver": "^7.7.0",
    "@typescript-eslint/eslint-plugin": "^8.10.0",
    "@typescript-eslint/parser": "^8.10.0",
    "cross-env": "^7.0.3",
    "eslint": "^8.56.0",
    "eslint-plugin-tsdoc": "^0.2.17",
    "nx": "20.1.3",
    "prettier": "^2.8.8",
    "semver": "^7.7.2",
    "typescript": "^5.6.3"
  }
}
