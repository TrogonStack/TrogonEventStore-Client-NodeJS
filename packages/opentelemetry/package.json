{
  "name": "@trogonstack/trogon-eventstore-opentelemetry",
  "version": "0.1.0",
  "description": "OpenTelemetry instrumentation for the TrogonEventStore Node.js client",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "license": "Apache-2.0",
  "author": "Straw Hat, LLC",
  "scripts": {
    "build": "yarn build:ts",
    "build:ts": "tsc --build",
    "build:watch": "yarn build:ts-watch",
    "build:ts-watch": "tsc --build --watch",
    "clean": "yarn clean:dist && yarn clean:buildinfo",
    "clean:dist": "shx rm -rf ./dist",
    "clean:buildinfo": "shx rm -rf *.tsbuildinfo"
  },
  "files": [
    "dist/"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TrogonStack/TrogonEventStore-Client-NodeJS.git"
  },
  "keywords": [
    "TrogonEventStore",
    "EventSourcing",
    "OpenTelemetry"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://npm.pkg.github.com"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/instrumentation": "^0.56.0"
  },
  "peerDependencies": {
    "@trogonstack/trogon-eventstore-client": "^0.0.1"
  },
  "devDependencies": {
    "@trogonstack/trogon-eventstore-client": "workspace:^"
  }
}
