{
  "name": "@trogonstack/trogon-eventstore-client",
  "version": "0.0.1",
  "description": "TrogonEventStore gRPC client for Node.js",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "yarn generate && yarn build:ts",
    "build:ts": "tsc --build",
    "build:watch": "yarn generate && yarn build:ts-watch",
    "build:ts-watch": "tsc --build --watch",
    "generate": "yarn generate:folder && yarn generate:sed-append && yarn generate:sed-insert && yarn generate:js && yarn generate:normalize",
    "generate:sed-append": "shx sed -i \"s/int64 ([A-z_]*) = ([0-9]*) \\[deprecated = true\\];/int64 \\$1 = \\$2 [deprecated = true, jstype = JS_STRING];/g\" ./protos/event_store/protocols/**/*.proto",
    "generate:sed-insert": "shx sed -i \"s/int64 ([A-z_]*) = ([0-9]*);/int64 \\$1 = \\$2 [jstype = JS_STRING];/g\" ./protos/event_store/protocols/**/*.proto",
    "generate:folder": "shx mkdir -p ./generated",
    "generate:js": "grpc_tools_node_protoc ./protos/event_store/protocols/**/*.proto --proto_path=./protos --grpc_out=grpc_js:./generated --js_out=import_style=commonjs,binary:./generated --ts_out=generate_package_definition:./generated",
    "generate:normalize": "node ./scripts/normalize-generated.mjs",
    "clean": "yarn clean:generated && yarn clean:dist && yarn clean:buildinfo",
    "clean:generated": "shx rm -rf ./generated",
    "clean:dist": "shx rm -rf ./dist",
    "clean:buildinfo": "shx rm -rf *.tsbuildinfo"
  },
  "files": [
    "dist/",
    "generated/"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TrogonStack/TrogonEventStore-Client-NodeJS.git"
  },
  "keywords": [
    "TrogonEventStore",
    "EventSourcing",
    "Client"
  ],
  "author": "Straw Hat, LLC",
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/TrogonStack/TrogonEventStore-Client-NodeJS/issues"
  },
  "homepage": "https://github.com/TrogonStack/TrogonEventStore-Client-NodeJS",
  "publishConfig": {
    "access": "public",
    "registry": "https://npm.pkg.github.com"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@grpc/grpc-js": "^1.14.3",
    "@types/debug": "^4.1.12",
    "@types/google-protobuf": "^3.15.12",
    "@types/node": "^22.10.2",
    "debug": "^4.4.0",
    "google-protobuf": "^3.21.4",
    "semver": "^7.7.2"
  },
  "devDependencies": {
    "@types/semver": "^7.7.0",
    "grpc-tools": "^1.13.1",
    "grpc_tools_node_protoc_ts": "^5.3.3",
    "nx": "20.1.3",
    "shx": "^0.3.4"
  }
}
